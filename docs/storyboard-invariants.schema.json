{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-invariants.schema.json",
  "title": "WebCap Storyboard Invariant Suggestions",
  "description": "Suggest only reusable character or location identities from Project Concept; legacy Directing Guidelines are not generated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invariants"
  ],
  "properties": {
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "text"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "location"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "For a character, a concrete reusable visual identity; for a location, a concrete reusable physical design."
          }
        }
      }
    }
  }
}
