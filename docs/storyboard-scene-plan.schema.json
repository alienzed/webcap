{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-scene-plan.schema.json",
  "title": "WebCap Storyboard Scene Plan",
  "description": "Structured Scene records authored by Director. WebCap stores the model-authored prompt text without semantic rewriting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenes"
  ],
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "prompt",
          "suggestedDurationSeconds"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "Short Scene overview / intent."
          },
          "entryState": {
            "type": "string",
            "description": "Optional planning note for a specific starting state or handoff."
          },
          "exitState": {
            "type": "string",
            "description": "Optional planning note for a specific ending state or handoff."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Complete model-authored MiniMax H3 generation prompt. WebCap stores it as authored."
          },
          "suggestedDurationSeconds": {
            "type": "number",
            "minimum": 6,
            "maximum": 15,
            "description": "Suggested clip duration in seconds."
          }
        }
      }
    }
  }
}
